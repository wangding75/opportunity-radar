# Required for docker-compose production deployment. The password is passed through PGPASSWORD,
# not interpolated into DATABASE_URL, so URL-reserved characters are safe.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Optional sources / analysis
GITHUB_TOKEN=
GOOGLE_TRENDS_GEOS=US,TW,GB,JP,KR
ANALYSIS_PROVIDER=heuristic
# Optional comma-separated priority, for example: http,heuristic
ANALYSIS_PROVIDER_PRIORITY=
ANALYSIS_PROVIDER_SELECTION_POLICY=priority
ANALYSIS_PROVIDER_RETRY_ATTEMPTS=2
ANALYSIS_PROVIDER_RETRY_BACKOFF_SECONDS=0.25
ANALYSIS_PROVIDER_CIRCUIT_OPEN_SECONDS=60
ANALYSIS_HTTP_ENDPOINT=
ANALYSIS_HTTP_API_KEY=
DISCOVERY_FEEDS_JSON=[]
PORT=8000

# Retention / operations
COLLECTION_RUN_RETENTION_DAYS=180
AUDIT_LOG_RETENTION_DAYS=365
ALERT_EVENT_RETENTION_DAYS=365
# Production notification delivery is disabled until an external provider is
# configured. Enabling email requires SMTP, explicit recipients, and TLS/SSL.
EMAIL_DELIVERY_ENABLED=false
WEBHOOK_DELIVERY_ENABLED=false
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
WEBHOOK_ALLOWED_HOSTS=
EMAIL_DELIVERY_PROVIDER=smtp
EMAIL_DELIVERY_RECIPIENTS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_REQUIRE_AUTH=true
SMTP_TIMEOUT_SECONDS=10
# Primary evidence rows remain protected; raw payload bodies can be cold-archived separately.
RAW_OBSERVATION_RETENTION_DAYS=0
RAW_PAYLOAD_ARCHIVE_DIR=/var/lib/opportunity-radar/archives
RAW_PAYLOAD_ARCHIVE_AFTER_DAYS=90
RAW_PAYLOAD_ARCHIVE_BATCH_SIZE=1000
SESSION_TTL_HOURS=24
AUTH_RECORD_RETENTION_DAYS=90
WORKER_STALE_SECONDS=180

# Runtime safety / worker liveness
MAX_REQUEST_BODY_BYTES=26214400
ANALYSIS_HTTP_TIMEOUT_SECONDS=20
MAINTENANCE_WORKER_STALE_SECONDS=1800
MAINTENANCE_INTERVAL_SECONDS=21600
DIGEST_INTERVAL_SECONDS=86400
WEEKLY_TRENDS_INTERVAL_SECONDS=604800
